# Spotify Web API - Client Credentials flow (catalogue public uniquement, pas de login utilisateur)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_WEB_API_BASE_URL=https://api.spotify.com/v1

# SRG SSR Music Platform / MX3 - OAuth2 Client Credentials
SRGSSR_MX3_CONSUMER_KEY=
SRGSSR_MX3_CONSUMER_SECRET=
SRGSSR_MX3_API_BASE_URL=https://api.srgssr.ch/mx3/v2
SRGSSR_OAUTH_TOKEN_URL=https://api.srgssr.ch/oauth/v1/accesstoken?grant_type=client_credentials

# Metabase - activer l'intégration signée après avoir créé le dashboard expert
METABASE_SITE_URL=http://localhost:3000
METABASE_EMBEDDING_SECRET_KEY=
METABASE_DASHBOARD_ID=

# Stockage local des assets (taille en octets, 25 Mo par défaut)
ASSET_STORAGE_DIR=data/uploads
ASSET_PUBLIC_BASE_URL=http://localhost:8000/uploads
ASSET_MAX_BYTES=26214400
